# Claude Code - Ignore large/session-specific files
.claude/plugins/cache/
.claude/plugins/marketplaces/
.claude/projects/
.claude/debug/
.claude/shell-snapshots/
.claude/telemetry/
.claude/todos/
.claude/file-history/
.claude/paste-cache/
.claude/history.jsonl
.claude/statsig/
.claude/session-env/
.claude/plans/
.claude/mind.mv2
.claude/ccline/
.claude/cache/
.claude/.mcp.json

# Conditional: disable claude on minimal installs (defaults to false if missing)
{{ if .minimal | default false }}
.claude/
.claude.json
{{ end }}

# --- OS targeting -----------------------------------------------------------
# On non-Windows: skip the Windows-only scripts and bootstrap.
{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
setup.ps1
{{ end }}

# On Windows: skip Unix-only shells, TUIs/GUIs, and the bash setup scripts.
{{ if eq .chezmoi.os "windows" }}
.zshrc
.zshrc_minimal
.zprofile
.profile
.bashrc
.tmux.conf
.envrc
.config/kitty
.config/rofi
.config/terminator
.config/ranger
# chezmoi strips run_once_/after_ prefixes, so target names are e.g. 55-setup-mise-config.sh
# -> match all bash scripts (covers setup.sh too).
*.sh
Brewfile.setup
terminator.vbs
{{ end }}
