# Normalize line endings across Windows + Unix.
# chezmoi writes files verbatim, so line-ending control must live here in Git.
* text=auto eol=lf

# Unix scripts/configs must stay LF (CRLF breaks bash/sh on Linux & WSL).
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf
*.fish    text eol=lf

# Windows scripts use CRLF.
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary assets — never normalize.
*.ttf     binary
*.otf     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.gif     binary
