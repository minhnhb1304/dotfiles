{{- $name := promptStringOnce . "name" "Git user name" -}}
{{- $email := promptStringOnce . "email" "Git email address" -}}
{{- $minimal := promptBoolOnce . "minimal" "Minimal installation" false -}}
{{- $claude_mcp := promptBoolOnce . "claude_mcp" "Setup Claude MCP" true -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    minimal = {{ $minimal }}
    claude_mcp = {{ $claude_mcp }}

[git]
    autoPush = false
    autoCommit = true

[edit]
    command = "nvim"

[merge]
    command = "nvim"
    args = ["-d"]

{{- if lookPath "pwsh" }}

# Run .ps1 scripts with PowerShell 7 (UTF-8, cross-platform).
# Only set when pwsh is present; otherwise chezmoi falls back to Windows PowerShell 5.1.
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{- end }}
